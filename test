local function getKnifeThrownRemote()
    local char = player.Character
    if not char then return nil end
    local knife = char:FindFirstChild("Knife")
    if not knife then return nil end
    local events = knife:FindFirstChild("Events")
    local remote = events and events:FindFirstChild("KnifeThrown")
    if remote and remote:IsA("RemoteEvent") then return remote end
    remote = knife:FindFirstChild("KnifeThrown", true)
    if remote and remote:IsA("RemoteEvent") then return remote end
    return nil
end

local function shouldSilentAimKnife()
    if not knifeSilentAimActive then return false end
    local role, alive = getMyRole()
    if not alive then return false end
    if role == "Murderer" then return true end
    local char = player.Character
    return char ~= nil and char:FindFirstChild("Knife") ~= nil
end

local function getKnifeSilentAimTarget()
    return findNearestTarget("Murderer")
end

local function getKnifeThrowCFrames(targetPlayer)
    local char = player.Character
    if not char or not targetPlayer or not targetPlayer.Character then return nil end
    local aimPart = getAimPart(targetPlayer.Character)
    if not aimPart then return nil end
    local targetPos = getPredictedPosition(targetPlayer, 2.8) or aimPart.Position
    local originPos = (char:FindFirstChild("RightHand") and char.RightHand.Position)
        or (getHRP(char) and getHRP(char).Position)
        or Vector3.new()
    local originCF
    if (originPos - targetPos).Magnitude < 0.01 then
        originCF = CFrame.new(originPos)
    else
        originCF = CFrame.lookAt(originPos, targetPos)
    end
    local targetCF = CFrame.new(targetPos)
    return originCF, targetCF
end

local function fireKnifeSilentAimAtRemote(knifeRemote)
    if silentAimBypass or not knifeRemote then return false end
    local target = getKnifeSilentAimTarget()
    if not target then return false end
    local originCF, targetCF = getKnifeThrowCFrames(target)
    if not originCF then return false end

    silentAimBypass = true
    local ok = pcall(function()
        if silentAimTrueFireServer then
            silentAimTrueFireServer(knifeRemote, originCF, targetCF)
        else
            knifeRemote:FireServer(originCF, targetCF)
        end
    end)
    silentAimBypass = false
    if ok then
        lastKnifeSilentAimShot = tick()
    end
    return ok
end

local function throwKnifeAtTarget()
    equipKnife()
    local remote = getKnifeThrownRemote()
    if not remote then return false end
    return fireKnifeSilentAimAtRemote(remote)
end

local function tryKnifeSilentAimThrow()
    if not shouldSilentAimKnife() then return false end
    if tick() - lastKnifeSilentAimShot < KNIFE_SILENT_AIM_COOLDOWN then return false end
    return throwKnifeAtTarget()
end

local function isKnifeThrowRemote(obj, method)
    if method ~= "FireServer" then return false end
    if typeof(obj) ~= "Instance" or not obj:IsA("RemoteEvent") then return false end
    if obj.Name ~= "KnifeThrown" then return false end
    local ancestor = obj:FindFirstAncestorWhichIsA("Tool")
    return ancestor ~= nil and ancestor.Name == "Knife"
end

local function shouldSilentAimGun()
    if not silentAimActive then return false end
    local role, alive = getMyRole()
    if not alive then return false end
    if role == "Sheriff" or role == "Hero" then return true end
    local char = player.Character
    return char ~= nil and char:FindFirstChild("Gun") ~= nil
end

local function getSilentAimTarget()
    if currentAimbotTarget and currentAimbotTarget.Parent and currentAimbotTarget.Character then
        local roles = cachedRoles
        local d = roles[currentAimbotTarget.Name]
        if not d or (not d.Killed and not d.Dead) then
            return currentAimbotTarget
        end
    end
    return findMurderer()
end

local function isGunShootRemote(obj, method)
    if method ~= "FireServer" then return false end
    if typeof(obj) ~= "Instance" or not obj:IsA("RemoteEvent") then return false end
    if obj.Name ~= "Shoot" then return false end
    local tool = obj.Parent
    if tool and tool:IsA("Tool") and tool.Name == "Gun" then return true end
    local ancestor = obj:FindFirstAncestorWhichIsA("Tool")
    return ancestor ~= nil and ancestor.Name == "Gun"
end

local function getSilentAimShotCFrames(targetPlayer)
    local char = player.Character
    if not char or not targetPlayer or not targetPlayer.Character then return nil end
    local aimPart = getAimPart(targetPlayer.Character)
    if not aimPart then return nil end
    local origin = (char:FindFirstChild("RightHand") and char.RightHand.Position)
        or (getHRP(char) and getHRP(char).Position)
        or Vector3.new()
    local targetPos = getPredictedPosition(targetPlayer, 2.8) or aimPart.Position
    return CFrame.new(origin), CFrame.new(targetPos)
end

local function fireSilentAimAtRemote(shootRemote)
    if silentAimBypass or not shouldSilentAimGun() or not shootRemote then return false end
    local target = getSilentAimTarget()
    if not target then return false end
    local originCF, targetCF = getSilentAimShotCFrames(target)
    if not originCF then return false end

    silentAimBypass = true
    local ok = pcall(function()
        if silentAimTrueFireServer then
            silentAimTrueFireServer(shootRemote, originCF, targetCF)
        else
            shootRemote:FireServer(originCF, targetCF)
        end
    end)
    silentAimBypass = false
    if ok then
        lastSilentAimShot = tick()
    end
    return ok
end

local function trySilentAimShoot()
    if not shouldSilentAimGun() then return false end
    if tick() - lastSilentAimShot < SILENT_AIM_SHOT_COOLDOWN then return false end

    local char = player.Character
    local gun = char and char:FindFirstChild("Gun")
    local shootRemote = gun and gun:FindFirstChild("Shoot")
    if shootRemote and shootRemote:IsA("RemoteEvent") then
        if fireSilentAimAtRemote(shootRemote) then
            return true
        end
    end

    if shootMurderer() then
        lastSilentAimShot = tick()
        return true
    end
    return false
end

local function processSilentAimNamecall(self, method)
    if silentAimBypass then return false end
    if checkcaller and checkcaller() then return false end
    if shouldSilentAimGun() and isGunShootRemote(self, method) then
        return fireSilentAimAtRemote(self)
    end
    if shouldSilentAimKnife() and isKnifeThrowRemote(self, method) then
        return fireKnifeSilentAimAtRemote(self)
    end
    return false
end

local function installSilentAimHook()
    if silentAimHookInstalled then return true end

    local installed = false
    pcall(function()
        if hookmetamethod and getnamecallmethod then
            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if processSilentAimNamecall(self, method) then return end
                if old then
                    return old(self, ...)
                end
            end)
            silentAimOldNamecall = old
            silentAimHookInstalled = true
            installed = true
        end
    end)

    if not installed then
        pcall(function()
            if not getrawmetatable or not setreadonly then return end
            local mt = getrawmetatable(game)
            if not mt or not mt.__namecall then return end
            silentAimOldNamecall = mt.__namecall
            local wrap = newcclosure or function(fn) return fn end
            local newHook = wrap(function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""
                if processSilentAimNamecall(self, method) then return end
                if silentAimOldNamecall then
                    return silentAimOldNamecall(self, ...)
                end
            end)
            setreadonly(mt, false)
            mt.__namecall = newHook
            setreadonly(mt, true)
            silentAimHookInstalled = true
            installed = true
        end)
    end

    return installed
end

local function hookKnifeThrowRemote(knife)
    if not knife or knife.Name ~= "Knife" or hookedKnifeTools[knife] then return end
    hookedKnifeTools[knife] = true
end

local function bindKnifeSilentAim(char)
