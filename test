function ESP.InitTracer(p)
    if ESP.tracers[p] then return end
    if not pcall(function() return Drawing.new("Line") end) then return end

    ESP.tracers[p] = Drawing.new("Line")
    local line = ESP.tracers[p]
    line.Visible = false; line.Thickness = 1.4; line.Transparency = 1
end

local function updateTracers()
    if not ESP.Tracers then
        for _, line in pairs(ESP.tracers) do
            if line then line.Visible = false end
        end
        return
    end

    local cam = workspace.CurrentCamera
    local cx, cy = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
    local centerFrom = Vector2.new(cx, cy)
    local myHRP = getHRP(player.Character)

    for _, p in ipairs(refreshCachedPlayers()) do
        if p == player then continue end
        local line = ESP.tracers[p]
        if not line then continue end

        local role, alive = getPlayerInfo(p)
        local show = shouldShowTracer(role)
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if not show or not char or not hrp or not myHRP then
            line.Visible = false
            continue
        end

        local pos, vis = cam:WorldToViewportPoint(hrp.Position)
        if not vis then
            line.Visible = false
            continue
        end

        line.From = centerFrom
        line.To = Vector2.new(pos.X, pos.Y)
        line.Color = getRoleColor(role, alive)
        line.Visible = true
    end
end

function ESP.StopAllTracers()
    for _, conn in ipairs(ESP.tracerConns) do pcall(function() conn:Disconnect() end) end
    ESP.tracerConns = {}
    for _, line in pairs(ESP.tracers) do pcall(function() line:Remove() end) end
    ESP.tracers = {}
end

local function initESPPlayer(p)
    if p == player then return end
    p.CharacterAdded:Connect(function() task.wait(0.5); updateNameTag(p); updateHighlight(p) end)
    p.CharacterRemoving:Connect(function()
        if ESP.billboards[p] then ESP.billboards[p]:Destroy(); ESP.billboards[p] = nil end
        if ESP.highlights[p] then ESP.highlights[p]:Destroy(); ESP.highlights[p] = nil end
    end)
    if p.Character then task.spawn(function() task.wait(0.5); updateNameTag(p); updateHighlight(p) end) end
end

local lastEspUpdate = 0
local ESP_UPDATE_INTERVAL = 0.2

local function espNeedsUpdate()
    return ESP.Names or ESP.Highlight
