local function findNearestTarget(excludeRole)
    local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local roles = getRoles()
    local nearest, nearDist = nil, math.huge
    for _, p in ipairs(refreshCachedPlayers()) do
        if p == player then continue end
        local d = roles[p.Name]
        if not d or d.Killed or d.Dead then continue end
        if excludeRole and d.Role == excludeRole then continue end
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local dist = (myHRP.Position - hrp.Position).Magnitude
        if dist < nearDist then
            nearDist = dist; nearest = p
        end
    end
    return nearest
end

