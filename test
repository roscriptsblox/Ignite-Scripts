local function createMobileToggle()
    local sg = Instance.new("ScreenGui"); sg.Name = "MM2MobileToggle"; sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Global; sg.DisplayOrder = 1000; sg.Parent = CoreGui

    local BUTTON_SIZE = 52
    local STROKE_THICKNESS = 2
    local IMAGE_INSET = STROKE_THICKNESS + 2

    local btn = Instance.new("Frame")
    btn.Name = "HubToggle"
    btn.Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE)
    btn.Position = UDim2.new(0, 10, 0.5, -BUTTON_SIZE / 2)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.BackgroundTransparency = 0
    btn.BorderSizePixel = 0
    btn.ClipsDescendants = true
    btn.Parent = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    local s = Instance.new("UIStroke")
    s.Thickness = STROKE_THICKNESS
    s.Color = Color3.fromRGB(0, 252, 0)
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = btn

    local img = Instance.new("ImageLabel")
    img.Name = "Icon"
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Position = UDim2.fromScale(0.5, 0.5)
    img.Size = UDim2.new(1, -IMAGE_INSET * 2, 1, -IMAGE_INSET * 2)
    img.BackgroundTransparency = 1
    img.Image = "rbxassetid://110513642514229"
    img.ScaleType = Enum.ScaleType.Crop
    img.ImageColor3 = Color3.fromRGB(255, 255, 255)
    img.ImageTransparency = 0
    img.ZIndex = 1
    img.Parent = btn

    local imgCorner = Instance.new("UICorner")
    imgCorner.CornerRadius = UDim.new(1, 0)
    imgCorner.Parent = img

    local b = Instance.new("TextButton")
    b.Name = "ClickArea"
    b.Size = UDim2.fromScale(1, 1)
    b.BackgroundTransparency = 1
    b.Text = ""
    b.AutoButtonColor = false
    b.Selectable = false
    b.ZIndex = 2
    b.Parent = btn
    local bDragging, bWasClick, bDragStart, bFrameStart, bTouchId
    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            bWasClick = true; bDragging = false; bTouchId = input
            bDragStart = Vector2.new(input.Position.X,input.Position.Y); bFrameStart = btn.Position
        end
    end)
    b.InputChanged:Connect(function(input)
        if not bDragStart then return end
        if input.UserInputType == Enum.UserInputType.Touch and bTouchId ~= input then return end
        local delta = Vector2.new(input.Position.X,input.Position.Y)-bDragStart
        if not bDragging and delta.Magnitude > 5 then bDragging = true; bWasClick = false end
        if bDragging then btn.Position = UDim2.new(bFrameStart.X.Scale,bFrameStart.X.Offset+delta.X,bFrameStart.Y.Scale,bFrameStart.Y.Offset+delta.Y) end
    end)
    b.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if input.UserInputType == Enum.UserInputType.Touch and bTouchId and bTouchId ~= input then return end
            if bWasClick and not bDragging then
                task.spawn(toggleHubWindow)
            end
            bDragging = false
            bWasClick = false
            bDragStart = nil
            bTouchId = nil
        end
    end)
end
