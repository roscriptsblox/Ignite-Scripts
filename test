local function getMainWindowSize()
    local profile = getDeviceProfile()
    local vp = profile.viewport
    local topInset = GuiService:GetGuiInset().Y
    local safeW = vp.X
    local safeH = vp.Y - topInset

    if profile.isPhone then
        return UDim2.fromOffset(
            math.floor(math.clamp(safeW * 0.94, 300, safeW - 12)),
            math.floor(math.clamp(safeH * 0.82, 340, safeH - 20))
        )
    elseif profile.isTablet then
        return UDim2.fromOffset(
            math.floor(math.clamp(safeW * 0.78, 440, 580)),
            math.floor(math.clamp(safeH * 0.74, 400, 540))
        )
    end

    if vp.X >= 1600 then
        return UDim2.fromOffset(620, 460)
    elseif vp.X >= 1280 then
        return UDim2.fromOffset(550, 400)
    end

    return UDim2.fromOffset(
        math.floor(math.min(550, safeW * 0.88)),
        math.floor(math.min(400, safeH * 0.78))
    )
end

