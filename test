local aimbotTargetPart = "Humanoid"
local aimbotPrediction = true
local currentAimbotTarget = nil

local function getAimPart(char)
    if not char then return nil end
    if aimbotTargetPart == "Head" then
        return char:FindFirstChild("Head") or getHRP(char)
    elseif aimbotTargetPart == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso") or getHRP(char)
    end
    return getHRP(char)
end

local function getPredictedPosition(target, offset)
    local char = target.Character
    if not char then return nil end
    local aimPart = getAimPart(char)
    local hrp = getHRP(char)
    local hum = char:FindFirstChild("Humanoid")
    if not aimPart then return nil end
    if not aimbotPrediction then
        return aimPart.Position
    end
    if not hum or not hrp then return aimPart.Position end
    local vel = hrp.AssemblyLinearVelocity
    local dir = hum.MoveDirection
    local predictedRoot = hrp.Position + (vel * Vector3.new(0.75, 0.5, 0.75)) * (offset / 15) + dir * offset
    if aimPart == hrp then
        return predictedRoot
    end
    return predictedRoot + (aimPart.Position - hrp.Position)
end

local visibilityRayParams = RaycastParams.new()
visibilityRayParams.FilterType = Enum.RaycastFilterType.Exclude
visibilityRayParams.IgnoreWater = true
local visibilityIgnoreList = {}
local visibilityIgnoreAt = 0
local VISIBILITY_IGNORE_INTERVAL = 0.5

local function rebuildVisibilityIgnore()
    table.clear(visibilityIgnoreList)
    local myChar = player.Character
    if myChar then
        table.insert(visibilityIgnoreList, myChar)
    end
    for _, p in ipairs(refreshCachedPlayers()) do
        local char = p.Character
        if char then
            table.insert(visibilityIgnoreList, char)
        end
    end
    visibilityRayParams.FilterDescendantsInstances = visibilityIgnoreList
    visibilityIgnoreAt = tick()
end

local function isVisible(targetPart)
    local cam = workspace.CurrentCamera
    local myChar = player.Character
    if not myChar or not targetPart then return false end

    if tick() - visibilityIgnoreAt >= VISIBILITY_IGNORE_INTERVAL then
        rebuildVisibilityIgnore()
    end

    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin

    local result = workspace:Raycast(origin, dir, visibilityRayParams)

    if not result then return true end
    if result.Instance:IsDescendantOf(targetPart.Parent) then return true end

    local pierceCount = 0
    local pierceIgnore = table.clone(visibilityIgnoreList)
    local pierceParams = visibilityRayParams
    while result and (result.Instance.Transparency >= 0.9 or not result.Instance.CanCollide) and pierceCount < 5 do
        table.insert(pierceIgnore, result.Instance)
        pierceParams = RaycastParams.new()
        pierceParams.FilterDescendantsInstances = pierceIgnore
        pierceParams.FilterType = Enum.RaycastFilterType.Exclude
        pierceParams.IgnoreWater = true
        result = workspace:Raycast(origin, dir, pierceParams)
        pierceCount = pierceCount + 1
    end

    if not result then return true end
    if result.Instance:IsDescendantOf(targetPart.Parent) then return true end

    return false
end

