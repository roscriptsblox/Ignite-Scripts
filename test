local function espLoop()
    if not espNeedsUpdate() then return end
    local now = tick()
    if now - lastEspUpdate < ESP_UPDATE_INTERVAL then return end
    lastEspUpdate = now
    for _, p in ipairs(refreshCachedPlayers()) do
        if p == player then continue end
        updateNameTag(p)
        updateHighlight(p)
    end
end

