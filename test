local function stepAimbot()
    if fovCircle then
        local cam = workspace.CurrentCamera
        fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        fovCircle.Visible = (cameraAimbotActive or silentAimActive or knifeSilentAimActive) and showFov
    end

    local aimActive = cameraAimbotActive or silentAimActive or knifeSilentAimActive
    if not aimActive then
        currentAimbotTarget = nil
        return
    end

    local scanTargets = cameraAimbotActive or perfFrame % 2 == 0
    if scanTargets then
        local target = nil
        local roles = cachedRoles
        local cam = workspace.CurrentCamera
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local bestDistSq = math.huge
        local fovRadiusSq = fovRadius * fovRadius

        local char = player.Character
        local holdingGun = char and char:FindFirstChild("Gun")
        local holdingKnife = char and char:FindFirstChild("Knife")
        local myRole = getMyRole()

        if knifeSilentAimActive and not silentAimActive and not cameraAimbotActive then
            currentAimbotTarget = findNearestTarget("Murderer")
        else
            for _, p in ipairs(refreshCachedPlayers()) do
                if p == player then continue end
                local d = roles[p.Name]
                if d and (d.Killed or d.Dead) then continue end

                local isMurderer = (d and d.Role == "Murderer") or (p.Backpack:FindFirstChild("Knife") or (p.Character and p.Character:FindFirstChild("Knife")))

                if holdingGun or myRole == "Sheriff" or myRole == "Hero" then
                    if not isMurderer then continue end
                elseif holdingKnife or myRole == "Murderer" or knifeSilentAimActive then
                    if isMurderer then continue end
                elseif not isMurderer then
                    continue
                end

                local aimPart = getAimPart(p.Character)
                if aimPart then
                    local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
                    if onScreen then
                        local dx = screenPos.X - center.X
                        local dy = screenPos.Y - center.Y
                        local distSq = dx * dx + dy * dy
                        if (not fovActive or distSq <= fovRadiusSq) and (not wallCheckActive or isVisible(aimPart)) then
                            if distSq < bestDistSq then
                                bestDistSq = distSq
                                target = p
                            end
                        end
                    elseif not fovActive and not wallCheckActive then
                        local dist3D = (aimPart.Position - cam.CFrame.Position).Magnitude
                        if dist3D + 10000 < bestDistSq then
                            bestDistSq = dist3D + 10000
                            target = p
                        end
                    end
                end
            end

            currentAimbotTarget = target
        end
    end

    if cameraAimbotActive and currentAimbotTarget and currentAimbotTarget.Character then
        local aimPart = getAimPart(currentAimbotTarget.Character)
        local myHRP = getHRP(player.Character)
        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
        if aimPart and myHRP and hum then
            local targetPos = getPredictedPosition(currentAimbotTarget, 2.8) or aimPart.Position
            local cam = workspace.CurrentCamera
            local targetCamCF = CFrame.new(cam.CFrame.Position, targetPos)
            cam.CFrame = cam.CFrame:Lerp(targetCamCF, aimbotSmoothness)
        end
    end
end

