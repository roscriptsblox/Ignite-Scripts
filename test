local function resetCharacter()
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
        end
    end)
end

local function resetAndWaitForCharacter()
    local oldChar = player.Character
    resetCharacter()
    task.wait(0.15)
    if player.Character == oldChar and oldChar then
        local hum = oldChar:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
        end
    end
    local char = player.Character
    if not char or char == oldChar then
        char = player.CharacterAdded:Wait()
    end
    return char, char:WaitForChild("HumanoidRootPart")
end

local function waitForMurderer(timeout)
    timeout = timeout or 12
    local deadline = tick() + timeout
    while tick() < deadline do
        local murderer = getMurdererPlayer()
        if murderer and murderer.Character then
            local hum = murderer.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.RootPart then
                return murderer
            end
        end
        task.wait(0.2)
    end
    return getMurdererPlayer()
end

local function waitForSheriff(timeout)
    timeout = timeout or 12
    local deadline = tick() + timeout
    while tick() < deadline do
        if amSheriff() then return nil end
        local sheriff = findSheriff()
        if sheriff and sheriff.Character then
            local hum = sheriff.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.RootPart then
                return sheriff
            end
        end
        task.wait(0.2)
    end
    if amSheriff() then return nil end
    return findSheriff()
end

local function skidFling(targetPlayer)
    if not targetPlayer then return false end

    local Character = player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = targetPlayer.Character
    if not TCharacter or not Character or not Humanoid or not RootPart then return false end

    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")

    if not TCharacter:FindFirstChildWhichIsA("BasePart") then return false end
    if not TRootPart and not THead and not Handle then return false end

    flingActive = true

    if RootPart.Velocity.Magnitude < 50 then
        oldFlingPos = RootPart.CFrame
    end

    local camera = workspace.CurrentCamera
    if THead then
        camera.CameraSubject = THead
    elseif Handle then
        camera.CameraSubject = Handle
    elseif THumanoid then
        camera.CameraSubject = THumanoid
    end

    local function FPos(BasePart, Pos, Ang)
        RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
        pcall(function()
            Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
        end)
        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end

    local function SFBasePart(BasePart)
        if not BasePart or not BasePart.Parent then return end
        local TimeToWait = 3
        local Time = tick()
        local Angle = 0
        repeat
            if RootPart and THumanoid and flingActive then
                if BasePart.Velocity.Magnitude < 50 then
                    Angle = Angle + 100
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                else
                    FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                end
            end
        until Time + TimeToWait < tick() or not flingActive
    end

    pcall(function()
        workspace.FallenPartsDestroyHeight = 0 / 0
    end)

    local BV = Instance.new("BodyVelocity")
    BV.Parent = RootPart
    BV.Velocity = Vector3.new(0, 0, 0)
    BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    TCharacter = targetPlayer.Character
    THumanoid = TCharacter and TCharacter:FindFirstChildOfClass("Humanoid")
    TRootPart = THumanoid and THumanoid.RootPart
    THead = TCharacter and TCharacter:FindFirstChild("Head")

    if TRootPart and TRootPart.Parent then
        SFBasePart(TRootPart)
    elseif THead and THead.Parent then
        SFBasePart(THead)
    elseif Handle and Handle.Parent then
        SFBasePart(Handle)
    else
        flingActive = false
        return false
    end

    BV:Destroy()
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    camera.CameraSubject = Humanoid

    if oldFlingPos then
        local returnDeadline = tick() + 6
        repeat
            if not RootPart or not RootPart.Parent then break end
            RootPart.CFrame = oldFlingPos * CFrame.new(0, 0.5, 0)
            pcall(function()
                Character:SetPrimaryPartCFrame(oldFlingPos * CFrame.new(0, 0.5, 0))
            end)
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            for _, part in ipairs(Character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Velocity = Vector3.zero
                    part.RotVelocity = Vector3.zero
                end
            end
            task.wait()
        until (RootPart.Position - oldFlingPos.Position).Magnitude < 25 or not flingActive or tick() >= returnDeadline
        pcall(function()
            workspace.FallenPartsDestroyHeight = savedFPDH
        end)
    end

    flingActive = false
    return true
end

startEndRound = function(opts)
    opts = opts or {}
    local shouldReset = opts.shouldReset ~= false
    local fromBagFull = opts.fromBagFull == true
    local resumeFarm = opts.resumeFarm ~= false

    if isFlinging or autoEndRoundInProgress then return end
    autoEndRoundInProgress = true
    isFlinging = true
    flingActive = true

    task.spawn(function()
        if resumeFarm then
            pauseFarmForEndRound()
        end

        if shouldReset then
            local char, hrp = resetAndWaitForCharacter()
            if char and hrp then
                character = char
                rootPart = hrp
            end
            task.wait(1.2)
        else
            character = player.Character
            rootPart = character and character:FindFirstChild("HumanoidRootPart")
            task.wait(0.3)
        end

        local murderer = waitForMurderer(12)
        for attempt = 1, 3 do
            if not flingActive or not isFlinging or not autoEndRoundInProgress then break end
            if not murderer or not murderer.Parent then
                murderer = waitForMurderer(4)
            end
            if murderer and murderer.Character and player.Character then
                character = player.Character
                rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local ok, didFling = pcall(skidFling, murderer)
                    if ok and didFling then
                        pcall(function()
                            Fluent:Notify({
                                Title = fromBagFull and "End Round" or "Fling Murderer",
                                Content = "Murderer flung successfully!",
                                Duration = 3,
                            })
                        end)
                        break
                    end
                end
            end
            task.wait(0.75)
        end

        autoEndRoundInProgress = false
        flingActive = false
        isFlinging = false
        pcall(function()
            workspace.FallenPartsDestroyHeight = savedFPDH
        end)
        if resumeFarm then
            if fromBagFull then
                resetBagState()
            end
            resumeFarmAfterEndRound()
        end
    end)
end

local flingSession = 0

local function resetFlingState()
    isFlinging = false
    flingActive = false
    stealGunActive = false
    pcall(function()
        workspace.FallenPartsDestroyHeight = savedFPDH
    end)
end

local function cancelFlingWork()
    flingSession += 1
    flingActive = false
    stealGunActive = false
end

local function startFlingWork()
    cancelFlingWork()
    local session = flingSession
    isFlinging = true
    flingActive = true
    return session
end

local function finishFlingWork(session)
    if session ~= flingSession then return end
    resetFlingState()
end

local function runSkidFlingOn(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    character = player.Character
    rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    local ok, didFling = pcall(skidFling, targetPlayer)
    return ok and didFling
end

local function flingMurderer()
    local session = startFlingWork()
    task.spawn(function()
        local murderer = waitForMurderer(12)
        if session ~= flingSession then return end
        if murderer then
            runSkidFlingOn(murderer)
        else
            pcall(function()
                Fluent:Notify({ Title = "Misc", Content = "Murderer not found", Duration = 3 })
            end)
        end
        finishFlingWork(session)
    end)
    return true
end

local function flingSheriff()
    if amSheriff() then return false, "You are the sheriff" end
    local session = startFlingWork()
    task.spawn(function()
        local sheriff = waitForSheriff(12)
        if session ~= flingSession then return end
        if sheriff then
            runSkidFlingOn(sheriff)
        else
            pcall(function()
                Fluent:Notify({ Title = "Misc", Content = "Sheriff not found", Duration = 3 })
            end)
        end
        finishFlingWork(session)
    end)
    return true
end

local function flingAllPlayers()
    local session = startFlingWork()
    task.spawn(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if session ~= flingSession then break end
            if p == player then continue end
            if p.Character and flingActive then
                runSkidFlingOn(p)
                task.wait(0.75)
            end
        end
        finishFlingWork(session)
    end)
    return true
end

local function stealGun()
    if amSheriff() then return false, "You are the sheriff" end

    local session = startFlingWork()
    stealGunActive = true

    task.spawn(function()
        local sheriff = waitForSheriff(12)
        if session ~= flingSession then return end

        if not sheriff then
            finishFlingWork(session)
            pcall(function()
                Fluent:Notify({ Title = "Misc", Content = "Sheriff not found", Duration = 3 })
            end)
            return
        end

        runSkidFlingOn(sheriff)
        task.wait(0.25)

        while not hasGun() and stealGunActive and session == flingSession do
            grabGun()
            task.wait(0.05)
        end

        local gotGun = hasGun()
        finishFlingWork(session)

        pcall(function()
            Fluent:Notify({
                Title = "Misc",
                Content = gotGun and "Stole the gun!" or "Flinged sheriff — gun not grabbed yet",
                Duration = 3,
            })
        end)
    end)
    return true
end

