    end
end

local function hookGunShootRemote(gun)
    if not gun or gun.Name ~= "Gun" or hookedGunTools[gun] then return end
    local shoot = gun:FindFirstChild("Shoot")
    if not shoot or not shoot:IsA("RemoteEvent") then return end
    hookedGunTools[gun] = true

    pcall(function()
        local oldFire = shoot.FireServer
        if type(oldFire) ~= "function" then return end
        shoot.FireServer = function(self, ...)
            if silentAimActive and not silentAimBypass and shouldSilentAimGun() then
                if fireSilentAimAtRemote(shoot) then
                    return
                end
            end
            return oldFire(self, ...)
        end
    end)

    pcall(function()
        gun.Activated:Connect(function()
            if not silentAimActive or silentAimBypass then return end
            task.defer(function()
                if silentAimActive and shouldSilentAimGun() then
                    trySilentAimShoot()
                end
            end)
        end)
    end)
end

