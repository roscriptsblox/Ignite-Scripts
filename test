local function executeKillAll()
    local mode = getMode()
    if not mode then return false end
    
    if mode == "sheriff" then
        return shootMurderer()
    elseif mode == "murderer" then
        local killedAnyone = false
        -- We loop through all valid targets and stab them instantly
        for _, p in ipairs(Players:GetPlayers()) do
            if p == player then continue end
            local d = cachedRoles[p.Name]
            if not d or d.Killed or d.Dead then continue end
            if d.Role == "Murderer" then continue end
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                stabTarget(p)
                killedAnyone = true
                task.wait(0.05) -- small delay to prevent crashing/rate limit
            end
        end
        return killedAnyone
    end
    return false
end

local function executeKillClosest()
    local role, alive = getMyRole()
    if not alive then return false end

    local myHRP = getHRP(player.Character)
    if not myHRP then return false end
    local lastCFrame = myHRP.CFrame

    local ok = false

    if role == "Sheriff" or role == "Hero" then
        local murderer = findMurderer()
        if murderer and murderer.Character then
            ok = shootMurderer()
        end
    elseif role == "Murderer" then
        local target = findNearestTarget("Murderer")
        if target then
            ok = stabTarget(target)
            pcall(function()
                local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum:UnequipTools() end
            end)
        end
    end

    if ok and myHRP.Parent then
        myHRP.CFrame = lastCFrame
        myHRP.AssemblyLinearVelocity = Vector3.zero
        myHRP.AssemblyAngularVelocity = Vector3.zero
    end

    return ok
end

local function executeThrowClosest()
    local role, alive = getMyRole()
    if not alive then return false end

    local target = findNearestTarget("Murderer")
    if not target or not target.Character then return false end

    equipKnife()
    task.wait(0.05)

    local char = player.Character
    if not char then return false end
    local knife = char:FindFirstChild("Knife")
    if not knife then return false end

    local events = knife:FindFirstChild("Events")
    local remote = events and events:FindFirstChild("KnifeThrown")
    if not remote or not remote:IsA("RemoteEvent") then
        remote = knife:FindFirstChild("KnifeThrown", true)
    end
    if not remote or not remote:IsA("RemoteEvent") then return false end

    local aimPart = getAimPart(target.Character)
    if not aimPart then return false end
    local targetPos = getPredictedPosition(target, 2.8) or aimPart.Position
    local originPos = (char:FindFirstChild("RightHand") and char.RightHand.Position)
        or (getHRP(char) and getHRP(char).Position)
    if not originPos then return false end

    local originCF
    if (originPos - targetPos).Magnitude < 0.01 then
        originCF = CFrame.new(originPos)
    else
        originCF = CFrame.lookAt(originPos, targetPos)
    end
    local targetCF = CFrame.new(targetPos)
    local ok = false
    pcall(function()
        remote:FireServer(originCF, targetCF)
        ok = true
    end)
    return ok
end

