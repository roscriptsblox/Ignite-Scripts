        end
    end
    return nil
end

local farmTargetCache = {}
local farmTargetCacheAt = 0
local FARM_TARGET_CACHE_INTERVAL = 0.6

local function refreshFarmTargets()
    table.clear(farmTargetCache)
    if autoFarmCandy then
        local coinContainer = findCoinContainer()
        if coinContainer then
            for _, coin in pairs(coinContainer:GetChildren()) do
                if coin:GetAttribute("CoinID") == "Candy" and coin:FindFirstChild("TouchInterest") then
                    table.insert(farmTargetCache, coin)
                end
            end
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name == "candy" then
                    table.insert(farmTargetCache, obj)
                end
            end
        end
    elseif autoFarmCoins then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Coin_Server" then
                table.insert(farmTargetCache, obj)
            end
        end
    end
    farmTargetCacheAt = tick()
end

