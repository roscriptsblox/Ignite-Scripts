    hl.FillTransparency = 0.65; hl.OutlineTransparency = 0.3; hl.OutlineColor = Color3.new(1,1,1)
    hl.FillColor = getRoleColor(role, alive); hl.Parent = char
    ESP.highlights[p] = hl
