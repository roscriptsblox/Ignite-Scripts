local function resolveWeaponId(itemName)
    if not itemName or itemName == "" then return nil, "Enter a weapon name" end
    if not DB_Item then return nil, "Item database not loaded" end
    if DB_Item[itemName] then return itemName end
    for k, _ in pairs(DB_Item) do
        if k:lower() == itemName:lower() then
            return k
        end
    end
    return nil, "Weapon not found: " .. itemName
end

local function getOwnedWeaponsList()
    local owned = {}
    if DB_Prof and DB_Prof.Weapons and DB_Prof.Weapons.Owned then
        for key, count in pairs(DB_Prof.Weapons.Owned) do
            if count > 0 and key ~= "DefaultKnife" and key ~= "DefaultGun" then
                table.insert(owned, key)
            end
        end
    end
    table.sort(owned)
    return owned
end

local function spawnItem(name)
    if not DB_Prof or not DB_Prof.Weapons then return false end
    local playerWeapons = DB_Prof.Weapons
    if not playerWeapons.Owned[name] then
        playerWeapons.Owned[name] = 1
    else
        playerWeapons.Owned[name] += 1
    end
    DB_Prof.Weapons = playerWeapons
    if Remotes then
        local inv = Remotes:FindFirstChild("Inventory")
        if inv then
            local ce = inv:FindFirstChild("ChangeInventoryItem")
            if ce then pcall(function() ce:FireServer(name, "Add") end) end
            local dc = inv:FindFirstChild("InventoryDataChanged")
            if dc then pcall(function() dc:Fire() end) end
        end
    end
    return true
end

local function giveitems(list)
    for _, key in ipairs(list) do
        spawnItem(key)
        task.wait(0.05)
