    if spawnAnims and ItemGift then
        for _, key in ipairs(list) do
            pcall(function() firesignal(ItemGift.OnClientEvent, key, "Weapons", 1) end)
            task.wait(0.02)
        end
        task.delay(0.1, function()
            local pg = player:FindFirstChild("PlayerGui")
            if not pg then return end
            for _, obj in pg:GetDescendants() do
                if obj.Name == "Claim" and (obj:IsA("ImageButton") or obj:IsA("TextButton")) then
                    pcall(function() firesignal(obj.Activated) end)
                    break
                end
            end
        end)
    end
end

local function dupeItems(list, amount)
    amount = amount or 1
    local ownedItems = {}
    if not DB_Prof or not DB_Prof.Weapons then return false, "Profile data not loaded" end
    local playerWeapons = DB_Prof.Weapons

    for _, key in ipairs(list) do
        if playerWeapons.Owned[key] and playerWeapons.Owned[key] > 0 then
            table.insert(ownedItems, key)
        end
    end

    if #ownedItems == 0 then
        return false, "You don't own this item"
    end

    for _, key in ipairs(ownedItems) do
        spawnItem(key)
        task.wait(0.08)
    end

    for i = 2, amount do
        for _, key in ipairs(ownedItems) do
            spawnItem(key)
            task.wait(0.08)
        end
        task.wait(0.1)
    end

    if ProfileDataChanged then
        pcall(function() ProfileDataChanged:Fire("Weapons", DB_Prof.Weapons) end)
    end

    if spawnAnims and ItemGift then
        for _, key in ipairs(ownedItems) do
            pcall(function() firesignal(ItemGift.OnClientEvent, key, "Weapons", 1) end)
            task.wait(0.02)
        end
        task.delay(0.3, function()
            local pg = player:FindFirstChild("PlayerGui")
            if not pg then return end
            for _, obj in pg:GetDescendants() do
                if obj.Name == "Claim" and (obj:IsA("ImageButton") or obj:IsA("TextButton")) then
                    pcall(function() firesignal(obj.Activated) end)
                    break
                end
            end
        end)
    end

    return true, #ownedItems
end

local function SpawnWeapon(itemName, amount)
    amount = amount or 1
    local id, err = resolveWeaponId(itemName)
    if not id then return false, err end
    for _ = 1, amount do
        giveitems({ id })
        task.wait(0.1)
    end
    return true, id
end

local function DupeWeapon(itemName, amount)
    amount = amount or 1
    local id, err = resolveWeaponId(itemName)
    if not id then return false, err end
    return dupeItems({ id }, amount)
end

