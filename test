local buttonTransparency = 0.15
local ScreenBtnConfig = {
    Shape = "Rectangle",
    UniformSize = 80,
    Width = 150,
    Height = 50,
}
local registeredScreenButtons = {}

local function getScreenButtonDimensions()
    if ScreenBtnConfig.Shape == "Rectangle" then
        return ScreenBtnConfig.Width, ScreenBtnConfig.Height
    end
    return ScreenBtnConfig.UniformSize, ScreenBtnConfig.UniformSize
end

local function applyScreenButtonStyle(btn)
    if not btn then return end
    local w, h = getScreenButtonDimensions()
    btn.Size = UDim2.new(0, w, 0, h)

    local corner = btn:FindFirstChildOfClass("UICorner")
    if not corner then
        corner = Instance.new("UICorner")
        corner.Parent = btn
    end

    if ScreenBtnConfig.Shape == "Circle" then
        corner.CornerRadius = UDim.new(1, 0)
    elseif ScreenBtnConfig.Shape == "Square" then
        corner.CornerRadius = UDim.new(0, 6)
    else
        corner.CornerRadius = UDim.new(0, 10)
    end

    local lbl = btn:FindFirstChildOfClass("TextLabel")
    if lbl then
        if ScreenBtnConfig.Shape == "Circle" or ScreenBtnConfig.Shape == "Square" then
            lbl.TextSize = math.clamp(math.floor(math.min(w, h) * 0.18), 9, 14)
        else
            lbl.TextSize = 13
        end
    end
end

local function refreshAllScreenButtons()
    for _, btn in ipairs(registeredScreenButtons) do
        applyScreenButtonStyle(btn)
    end
end

