local lastShiftLockState = false

local function isShiftLocked()
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return true
    end
    if UserInputService.TouchEnabled then
        local camera = workspace.CurrentCamera
        if camera and camera.CameraType == Enum.CameraType.Follow then
            local char = player.Character
            if char then
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
                    return true
                end
            end
        end
        if getgenv and getgenv().ShiftLock == true then
            return true
        end
    end
    return false
end

local function updateCrosshairState(shiftLocked)
    if not crosshairEnabled or not shiftLocked then
        crosshairGui.Enabled = false
        crosshairRotation = 0
        crosshairContainer.Rotation = 0
        pcall(function() UserInputService.MouseIconEnabled = true end)
        return
    end

    crosshairGui.Enabled = true
    pcall(function() UserInputService.MouseIconEnabled = false end)
end

local function onCrosshairToggle(enabled)
    crosshairEnabled = enabled
    lastShiftLockState = isShiftLocked()
    if not enabled then
        pcall(function() UserInputService.MouseIconEnabled = true end)
    end
    updateCrosshairState(lastShiftLockState)
end

local function stepCrosshair(dt)
    if not crosshairEnabled then return end

    local locked = isShiftLocked()
    if locked ~= lastShiftLockState then
        lastShiftLockState = locked
        updateCrosshairState(locked)
    end

    if crosshairGui.Enabled then
        if crosshairRotate then
            crosshairRotation = (crosshairRotation + dt * crosshairRotationSpeed) % 360
            crosshairContainer.Rotation = crosshairRotation
        else
            crosshairContainer.Rotation = 0
        end
    end
end

